{
  "name": "saltline-fable-5.2-react",
  "version": "1.0.0",
  "description": "Saltline FPS — React and TypeScript application with modular Three.js game systems",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.12.0"
  }
}
